.btn { padding: 5px var(--base-size-16); font-size: 14px; font-weight: var(--base-text-weight-medium,500); white-space: nowrap; vertical-align: middle; cursor: pointer; user-select: none; appearance: none; border: 1px solid; border-radius: 6px; line-height: 20px; display: inline-block; position: relative; }

