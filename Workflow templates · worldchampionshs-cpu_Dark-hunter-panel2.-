.QueryBuilder-Input { color: rgba(0, 0, 0, 0); resize: none; min-width: 100%; caret-color: var(--fgColor-default,var(--color-fg-default)); background: 0px 0px; border: 0px; outline: none; padding: 0px; display: flex; position: relative; overflow: auto hidden; }

