.convert-to-issue-enabled .task-list-item.is-loading { color: var(--fgColor-muted); background-color: var(--bgColor-accent-muted); border-top: var(--borderWidth-thin) solid var(--borderColor-accent-muted); border-bottom: var(--borderWidth-thin) solid var(--bgColor-default); border-left: var(--borderWidth-thin) solid var(--bgColor-default); }

