.CircleBadge--small { width: 56px; height: 56px; }

.CircleBadge--medium { width: 96px; height: 96px; }

.CircleBadge--large { width: 128px; height: 128px; }

.DashedConnection { position: relative; }

.DashedConnection::before { content: ""; border-bottom: 2px dashed var(--borderColor-default,var(--color-border-default)); width: 100%; position: absolute; top: 50%; left: 0px; }

.DashedConnection .CircleBadge { position: relative; }

.branch-name { font: 12px var(--fontStack-monospace,ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, Liberation Mono, monospace); color: var(--fgColor-muted,var(--color-fg-muted)); word-break: break-all; background-color: var(--bgColor-accent-muted,var(--color-accent-subtle)); border-radius: 6px; padding: 2px 6px; display: inline-block; }

.branch-name .octicon { color: var(--fgColor-muted,var(--color-fg-muted)); margin: 1px -2px 0px 0px; }

