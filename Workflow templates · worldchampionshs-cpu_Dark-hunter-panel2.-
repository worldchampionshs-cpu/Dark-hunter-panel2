.Box--overlay { background-color: var(--bgColor-default,var(--color-canvas-default)); border-color: var(--borderColor-default,var(--color-border-default)); background-clip: padding-box; width: 448px; margin-left: auto; margin-right: auto; box-shadow: rgba(0, 0, 0, 0.4) 0px 0px 18px; }

.Box--overlay .Box-header { border-width: 0px 0px 1px; border-top-left-radius: 6px; border-top-right-radius: 6px; margin: 0px; }

.Box-overlay--narrow { width: 320px; }

.Box-overlay--wide { width: 640px; }

