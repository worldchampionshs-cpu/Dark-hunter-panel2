.AvatarStack--large { min-width: calc(32px + var(--base-size-4) + var(--base-size-8)); height: 32px; }

.AvatarStack--large.AvatarStack--two { min-width: calc(32px + var(--base-size-4)*2 + var(--base-size-8)); }

.AvatarStack--large.AvatarStack--three-plus { min-width: calc(32px + var(--base-size-4)*3 + var(--base-size-8)); }

