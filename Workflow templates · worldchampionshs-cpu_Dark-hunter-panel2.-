.Box-header { padding: var(--stack-padding-normal); margin: calc(var(--borderWidth-thin)*-1) calc(var(--borderWidth-thin)*-1) 0; background-color: var(--bgColor-muted); border-color: var(--borderColor-default); border-style: solid; border-width: var(--borderWidth-thin); border-top-left-radius: var(--borderRadius-medium); border-top-right-radius: var(--borderRadius-medium); }

.Box-title { font-size: var(--text-body-size-medium); font-weight: var(--base-text-weight-semibold); }

.Box-body { padding: var(--stack-padding-normal); border-bottom: var(--borderWidth-thin) solid var(--borderColor-default); }

