.dropdown { position: relative; }

.dropdown-caret { vertical-align: middle; content: ""; border-style: solid; border-width: var(--borderWidth-thicker) var(--borderWidth-thicker) 0; border-bottom-color: rgba(0, 0, 0, 0); border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); width: 0px; height: 0px; display: inline-block; }

.dropdown-menu { z-index: 100; width: 160px; padding-top: var(--control-small-paddingBlock); padding-bottom: var(--control-small-paddingBlock); margin-top: var(--base-size-2); background-color: var(--overlay-bgColor); border: var(--borderWidth-thin) solid var(--borderColor-default); border-radius: var(--borderRadius-medium); box-shadow: var(--shadow-floating-small); background-clip: padding-box; list-style: none; position: absolute; top: 100%; left: 0px; }

