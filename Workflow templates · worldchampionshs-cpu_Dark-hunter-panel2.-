}

.project-card.moving { transform: translate(4px) translateY(0px); background-color: var(--bgColor-accent-muted) !important; box-shadow: 0 0 0 2px var(--borderColor-accent-emphasis) !important; }

.issue-card.draggable { cursor: move; }

