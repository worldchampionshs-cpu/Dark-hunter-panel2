.UnderlineNav-item:focus, .UnderlineNav-item:focus-visible, .UnderlineNav-item:hover { color: var(--fgColor-default); border-bottom-color: var(--borderColor-neutral-muted); outline-offset: -2px; text-decoration: none; transition: border-bottom-color 0.12s ease-out; }

