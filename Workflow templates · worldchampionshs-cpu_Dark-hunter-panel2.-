:is(:is(.Overlay-header .Overlay-headerContentWrap) .Overlay-titleWrap) .Overlay-description { font-size: var(--text-body-size-small); font-weight: var(--base-text-weight-normal); color: var(--fgColor-muted); margin: 0px; }

.Overlay-headerFilter { padding: var(--stack-gap-condensed) var(--stack-gap-condensed) 0 var(--stack-gap-condensed); }

.Overlay-body { padding: var(--stack-padding-normal); scrollbar-width: thin; font-size: var(--text-body-size-medium); flex-grow: 1; overflow-y: auto; }

