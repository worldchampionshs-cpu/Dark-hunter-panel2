.review-comment { padding: var(--base-size-8) var(--base-size-16); color: var(--fgColor-default); position: relative; }

.review-comment:first-child { padding-top: var(--base-size-16); }

.review-comment:last-child { padding-bottom: var(--base-size-16); }

