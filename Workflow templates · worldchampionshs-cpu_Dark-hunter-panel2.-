.Header { z-index: 32; padding: var(--base-size-16); color: var(--header-fgColor-default,var(--color-header-text)); background-color: var(--header-bgColor,var(--color-header-bg)); flex-wrap: nowrap; align-items: center; font-size: 14px; line-height: 1.5; display: flex; }

