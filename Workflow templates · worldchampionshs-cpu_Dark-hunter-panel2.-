.Layout { --Layout-sidebar-width: 220px; --Layout-gutter: 16px; display: grid; }

@media (width <= 543.98px) {
  .Layout { grid-auto-flow: row; grid-template-columns: 1fr !important; }
  .Layout :is(.Layout-divider, .Layout-main, .Layout-sidebar) { grid-column: 1 !important; width: 100% !important; }
  .Layout.Layout--sidebarPosition-flowRow-start .Layout-sidebar { grid-row: 1; }
  .Layout.Layout--sidebarPosition-flowRow-end .Layout-sidebar, .Layout.Layout--sidebarPosition-flowRow-start .Layout-main { grid-row: 2 / span 2; }
  .Layout.Layout--sidebarPosition-flowRow-end .Layout-main { grid-row: 1; }
  .Layout.Layout--sidebarPosition-flowRow-none .Layout-sidebar { display: none; }
  .Layout.Layout--divided { --Layout-gutter: 0; }
  .Layout.Layout--divided .Layout-divider { grid-row: 2; height: 1px; }
