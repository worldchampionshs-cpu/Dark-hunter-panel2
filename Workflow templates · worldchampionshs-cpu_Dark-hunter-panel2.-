.dropdown-item { padding: var(--control-small-paddingBlock) var(--control-medium-paddingInline-condensed) var(--control-small-paddingBlock) var(--control-medium-paddingInline-spacious); color: var(--fgColor-default); text-overflow: ellipsis; white-space: nowrap; display: block; overflow: hidden; }

.dropdown-item:hover { color: var(--fgColor-onEmphasis); background-color: var(--bgColor-accent-emphasis); text-decoration: none; }

