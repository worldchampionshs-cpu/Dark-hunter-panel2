.orghead { padding-top: var(--base-size-16); margin-bottom: var(--base-size-16); color: var(--fgColor-default); background-color: var(--page-header-bgColor); border-bottom: solid var(--borderWidth-thin) var(--borderColor-default); padding-bottom: 0px; }

