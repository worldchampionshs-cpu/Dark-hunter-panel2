.pagination .current, .pagination .current:hover, .pagination [aria-current]:not([aria-current="false"]) { color: var(--fgColor-onEmphasis,var(--color-fg-on-emphasis)); background-color: var(--bgColor-accent-emphasis,var(--color-accent-emphasis)); border-color: rgba(0, 0, 0, 0); }

