.markdown-body { font-family: var(--fontStack-sansSerif,-apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji"); overflow-wrap: break-word; font-size: 16px; line-height: 1.5; }

