.Overlay-footer { z-index: 1; padding: 0 var(--stack-padding-normal) var(--stack-padding-normal) var(--stack-padding-normal); flex-flow: wrap; flex-shrink: 0; display: flex; }

.Overlay-footer.Overlay-footer--divided { padding-top: var(--stack-padding-normal); box-shadow: inset 0 var(--borderWidth-thin) var(--borderColor-default); }

