.pending-cards-status { border: var(--borderWidth-thick) solid var(--bgColor-default); background-image: linear-gradient(rgb(84, 163, 255), rgb(0, 110, 237)); background-clip: padding-box; width: 14px; height: 14px; top: -2px; right: -9px; }

.project-column { background-color: var(--bgColor-inset); min-width: 100%; max-width: 100%; border-width: 0px !important; border-radius: 0px !important; }

.project-column:focus { outline: none; }

@media (width >= 544px) {
