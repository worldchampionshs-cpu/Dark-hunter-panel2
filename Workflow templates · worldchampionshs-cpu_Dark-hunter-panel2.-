}

.Box-row--drag-button { opacity: 0; }

.Box-footer { padding: var(--stack-padding-normal); margin-top: calc(var(--borderWidth-thin)*-1); border-top: var(--borderWidth-thin) solid var(--borderColor-default); border-radius: 0 0 var(--borderRadius-medium) var(--borderRadius-medium); }

.Box--scrollable { max-height: 324px; overflow: scroll; }

