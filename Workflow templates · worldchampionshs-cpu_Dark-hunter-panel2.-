.reorderable-task-lists .markdown-body .task-list-item .drag-handle { fill: var(--fgColor-default); }

.reorderable-task-lists .markdown-body .task-list-item.hovered > .handle { opacity: 1; }

.reorderable-task-lists .markdown-body .task-list-item.is-dragging { opacity: 0; }

.reorderable-task-lists .markdown-body ul:dir(rtl) .task-list-item, .reorderable-task-lists .markdown-body ol:dir(rtl) .task-list-item { margin-right: 0px; }

